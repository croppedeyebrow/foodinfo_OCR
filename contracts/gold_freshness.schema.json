{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neulsom.local/schemas/gold-freshness-1.0.0.json",
  "title": "Gold freshness profile for Backend",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "batch_id",
    "record_id",
    "source",
    "source_record_id",
    "content_hash",
    "parser_version",
    "created_at",
    "dataset_version",
    "external_product_id",
    "food_mapping_key",
    "product_name",
    "storage_type",
    "selected_source",
    "confidence",
    "review_status"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "run_id": { "type": "string", "minLength": 1 },
    "batch_id": { "type": "string", "minLength": 1 },
    "record_id": { "type": "string", "minLength": 1 },
    "source": { "const": "GOLD" },
    "source_record_id": { "type": "string", "minLength": 1 },
    "source_uri": { "type": ["string", "null"] },
    "content_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "parser_version": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "dataset_version": { "type": "string", "minLength": 1 },
    "external_product_id": { "type": "string", "minLength": 1 },
    "food_mapping_key": { "type": "string", "minLength": 1 },
    "product_name": { "type": "string", "minLength": 1 },
    "storage_type": {
      "type": "string",
      "enum": ["REFRIGERATED", "FROZEN", "ROOM", "UNKNOWN"]
    },
    "expiration_value": { "type": ["number", "null"] },
    "expiration_unit": {
      "type": ["string", "null"],
      "enum": ["DAY", "MONTH", "YEAR", "HOUR", null]
    },
    "expiration_basis": {
      "type": ["string", "null"],
      "enum": ["MANUFACTURE", "PACKING", "OPENING", "UNKNOWN", null]
    },
    "selected_source": {
      "type": "string",
      "enum": ["KURLY", "MFDS", "MANUAL"]
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "review_status": {
      "type": "string",
      "enum": ["APPROVED", "REVIEW_REQUIRED", "REJECTED"]
    }
  }
}
