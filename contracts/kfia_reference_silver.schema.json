{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neulsom.local/schemas/kfia-reference-silver-1.0.0.json",
  "title": "KFIA reference silver record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "batch_id",
    "record_id",
    "source",
    "source_record_id",
    "content_hash",
    "parser_version",
    "created_at",
    "reference_item_code",
    "storage_type_raw",
    "storage_type",
    "reference_shelf_life_days",
    "original_unit",
    "source_document",
    "source_page",
    "review_status",
    "quality_rule_version"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "run_id": { "type": "string", "minLength": 1 },
    "batch_id": { "type": "string", "minLength": 1 },
    "record_id": { "type": "string", "minLength": 1 },
    "source": { "const": "KFIA" },
    "source_record_id": { "type": "string", "minLength": 1 },
    "content_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "parser_version": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "minLength": 1 },
    "reference_item_code": { "type": "string", "minLength": 1 },
    "food_type": { "type": ["string", "null"] },
    "food_name": { "type": ["string", "null"] },
    "storage_type_raw": { "type": "string" },
    "storage_type": {
      "type": "string",
      "enum": ["REFRIGERATED", "FROZEN", "AMBIENT", "UNKNOWN"]
    },
    "reference_temperature_raw": { "type": ["string", "null"] },
    "reference_shelf_life_days": { "type": "number" },
    "original_unit": { "type": "string", "minLength": 1 },
    "source_document": { "type": "string", "minLength": 1 },
    "source_page": { "type": "integer", "minimum": 1 },
    "review_status": {
      "type": "string",
      "enum": ["APPROVED", "REVIEW_REQUIRED", "REJECTED"]
    },
    "quality_rule_version": { "type": "string", "minLength": 1 },
    "quality_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rule_id", "severity"],
        "properties": {
          "rule_id": { "type": "string" },
          "severity": { "type": "string" },
          "message": { "type": "string" }
        }
      }
    }
  }
}
