{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neulsom.local/schemas/kfia-reference-bronze-1.0.0.json",
  "title": "KFIA reference bronze record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "batch_id",
    "record_id",
    "source",
    "source_record_id",
    "content_hash",
    "parser_version",
    "created_at",
    "reference_item_code",
    "reference_shelf_life_days",
    "original_unit",
    "temperature_details",
    "source_document",
    "source_page",
    "extracted_at",
    "native_contract_version",
    "source_row_index",
    "raw_payload"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "run_id": { "type": "string", "minLength": 1 },
    "batch_id": { "type": "string", "minLength": 1 },
    "record_id": { "type": "string", "minLength": 1 },
    "source": { "const": "KFIA" },
    "source_record_id": { "type": "string", "minLength": 1 },
    "content_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "parser_version": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "minLength": 1 },
    "reference_item_code": { "type": "string", "minLength": 1 },
    "food_type": { "type": ["string", "null"] },
    "food_name": { "type": ["string", "null"] },
    "appearance_raw": { "type": ["string", "null"] },
    "packaging_raw": { "type": ["string", "null"] },
    "existing_shelf_life_raw": { "type": ["string", "null"] },
    "storage_temperature_raw": { "type": ["string", "null"] },
    "storage_type_raw": { "type": ["string", "null"] },
    "reference_temperature_raw": { "type": ["string", "null"] },
    "quality_limit_days": { "type": ["number", "null"] },
    "safety_factor_raw": { "type": ["string", "null"] },
    "safety_factor": { "type": ["number", "null"] },
    "reference_shelf_life_days": { "type": "number" },
    "original_unit": { "type": "string", "minLength": 1 },
    "temperature_details": { "type": "array" },
    "source_document": { "type": "string", "minLength": 1 },
    "source_page": { "type": "integer", "minimum": 1 },
    "extracted_at": { "type": "string", "minLength": 1 },
    "native_contract_version": { "type": "string", "minLength": 1 },
    "source_row_index": { "type": "integer", "minimum": 0 },
    "raw_payload": { "type": "object" }
  }
}
