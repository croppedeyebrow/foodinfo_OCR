{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neulsom.local/schemas/mfds-raw-record-1.0.0.json",
  "title": "MFDS PDF bronze raw record",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "run_id",
    "batch_id",
    "record_id",
    "source",
    "source_record_id",
    "content_hash",
    "parser_version",
    "created_at",
    "document_id",
    "raw_text"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "run_id": { "type": "string", "minLength": 1 },
    "batch_id": { "type": "string", "minLength": 1 },
    "record_id": { "type": "string", "minLength": 1 },
    "source": { "const": "MFDS" },
    "source_record_id": { "type": "string", "minLength": 1 },
    "source_uri": { "type": ["string", "null"] },
    "content_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "parser_version": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "document_id": { "type": "string", "minLength": 1 },
    "page_number": { "type": ["integer", "null"], "minimum": 1 },
    "food_name_raw": { "type": ["string", "null"] },
    "storage_method_raw": { "type": ["string", "null"] },
    "expiration_info_raw": { "type": ["string", "null"] },
    "raw_text": { "type": "string" }
  }
}
