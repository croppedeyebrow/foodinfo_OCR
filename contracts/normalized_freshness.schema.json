{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neulsom.local/schemas/normalized-freshness-1.0.0.json",
  "title": "Silver normalized freshness",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "batch_id",
    "record_id",
    "source",
    "source_record_id",
    "content_hash",
    "parser_version",
    "created_at",
    "food_name_normalized",
    "storage_type"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "run_id": { "type": "string", "minLength": 1 },
    "batch_id": { "type": "string", "minLength": 1 },
    "record_id": { "type": "string", "minLength": 1 },
    "source": { "type": "string", "enum": ["KURLY", "MFDS"] },
    "source_record_id": { "type": "string", "minLength": 1 },
    "source_uri": { "type": ["string", "null"] },
    "content_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "parser_version": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "food_name_normalized": { "type": "string", "minLength": 1 },
    "storage_type": {
      "type": "string",
      "enum": ["REFRIGERATED", "FROZEN", "ROOM", "UNKNOWN"]
    },
    "expiration_value": { "type": ["number", "null"] },
    "expiration_unit": {
      "type": ["string", "null"],
      "enum": ["DAY", "MONTH", "YEAR", "HOUR", null]
    },
    "expiration_basis": {
      "type": ["string", "null"],
      "enum": ["MANUFACTURE", "PACKING", "OPENING", "UNKNOWN", null]
    },
    "expiration_text_raw": { "type": ["string", "null"] }
  }
}
