{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neulsom.local/schemas/collection-submission-1.0.0.json",
  "title": "Collection batch submission",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "batch_id",
    "record_id",
    "source",
    "source_record_id",
    "content_hash",
    "parser_version",
    "created_at",
    "member",
    "status",
    "row_count",
    "products",
    "artifacts"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "run_id": { "type": "string", "minLength": 1 },
    "batch_id": { "type": "string", "minLength": 1 },
    "record_id": { "type": "string", "minLength": 1 },
    "source": { "const": "KURLY_COLLECTION" },
    "source_record_id": { "type": "string", "minLength": 1 },
    "source_uri": { "type": ["string", "null"] },
    "content_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "parser_version": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "member": { "type": "string", "minLength": 1 },
    "status": {
      "type": "string",
      "enum": ["READY", "ACCEPTED", "REJECTED", "DRAFT"]
    },
    "row_count": { "type": "integer", "minimum": 0 },
    "supported_consumer_versions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "default": ["1.0.0"]
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["products_csv_uri"],
      "properties": {
        "products_csv_uri": { "type": "string", "minLength": 1 },
        "failures_csv_uri": { "type": ["string", "null"] },
        "discovery_dir_uri": { "type": ["string", "null"] }
      }
    },
    "products": {
      "type": "array",
      "items": { "$ref": "#/$defs/submitted_product" }
    }
  },
  "$defs": {
    "submitted_product": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "schema_version",
        "run_id",
        "batch_id",
        "record_id",
        "source",
        "source_record_id",
        "content_hash",
        "parser_version",
        "created_at",
        "original_product_id",
        "product_name_raw",
        "product_url"
      ],
      "properties": {
        "schema_version": { "const": "1.0.0" },
        "run_id": { "type": "string", "minLength": 1 },
        "batch_id": { "type": "string", "minLength": 1 },
        "record_id": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "source_record_id": { "type": "string", "minLength": 1 },
        "source_uri": { "type": ["string", "null"] },
        "content_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "parser_version": { "type": "string", "minLength": 1 },
        "created_at": { "type": "string", "format": "date-time" },
        "original_product_id": { "type": "string", "minLength": 1 },
        "product_name_raw": { "type": "string", "minLength": 1 },
        "product_url": { "type": "string", "minLength": 1 },
        "food_name_candidate": { "type": ["string", "null"] },
        "sales_unit_raw": { "type": ["string", "null"] },
        "weight_raw": { "type": ["string", "null"] },
        "quantity_raw": { "type": ["string", "null"] },
        "food_type_raw": { "type": ["string", "null"] },
        "food_type_source": { "type": ["string", "null"] },
        "expiration_info_raw": { "type": ["string", "null"] },
        "expiration_source": { "type": ["string", "null"] },
        "storage_method_raw": { "type": ["string", "null"] },
        "storage_source": { "type": ["string", "null"] },
        "storage_type": { "type": ["string", "null"] },
        "ocr_confidence": { "type": ["number", "null"] },
        "crawl_collected_at": { "type": ["string", "null"], "format": "date-time" },
        "ocr_collected_at": { "type": ["string", "null"], "format": "date-time" },
        "validation_status": { "type": ["string", "null"] },
        "parse_status": { "type": ["string", "null"] },
        "image_sha256": { "type": ["string", "null"] }
      }
    }
  }
}
